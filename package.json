    "react-dom": "19.3.1",
    "react-leaflet": "^5.0.0",
    "resend": "^6.34.1",
    "stripe": "^23.0.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^26",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^18.0.9",
